#!/bin/sh
if test ! -e Minimal.db; then
  echo `pwd` does not appear to be a LambdaMOO source directory
  exit 1
fi

# parameters;
l8tf_alltests_to_subj=..
#   paths w.r.t. subject root
l8tf_alltests=tests
l8tf_root=../l8tf

l8tf_abs_subj=`pwd`

l8tf_abs_alltests="$l8tf_abs_subj/$l8tf_alltests"
l8tf_abs_root="$l8tf_abs_subj/$l8tf_root"
l8tf_alltests_to_root="$l8tf_alltests_to_subj/$l8tf_root"

testing_ac_file="testing.ac"
testing_ac_hdr="dnl -- $testing_ac_file -- generated by l8tf/install-l8tf"
if test -r testing.ac &&
   test "x`sed -e '2,$d' $testing_ac_file`" != "x$testing_ac_hdr"
then
  printf "%s\n" \
"$testing_ac_file already exists and appears to have
been manually created; please remove or rename it"
  exit 1
fi
testing_ac_tmp=`mktemp -q -t l8tftacXXXXXXXXXX` || { printf 'could not create temp file'; exit 1; }
cat <<EOF >$testing_ac_tmp
$testing_ac_hdr
dnl |             DO NOT EDITX                        |
dnl \`------------------------------------------------'
m4_define([L8_PATH_SUBJ_TO_ROOT],[$l8tf_root])dnl
m4_define([L8_PATH_SUBJ_TO_ALLTESTS],[$l8tf_alltests])dnl
m4_define([L8_PATH_BUILD_TO_TESTRUN],[t])dnl
m4_include([$l8tf_root/subject_config.ac])
EOF
if test -r "$testing_ac_file" && diff -q "$testing_ac_tmp" "$testing_ac_file" >/dev/null; then :
else
    mv -f "$testing_ac_tmp" "$testing_ac_file"
    chmod 664 "$testing_ac_file"
fi

cd $l8tf_root
if test ! -e alltests_config.ac; then
  echo `pwd` does not appear to be an L8TF root directory
  exit 1
fi

alltests_configure="$l8tf_abs_subj/$l8tf_alltests/configure"
{
   printf 'm4_define([L8_PATH_%s],[%s])dnl\n' \
     ABS_SUBJ         "$l8tf_abs_subj" \
     SUBJ_TO_ALLTESTS "$l8tf_alltests" \
     ALLTESTS_TO_ROOT "$l8tf_alltests_to_root"
   cat alltests_config.ac;
} | autoconf - >"$alltests_configure"
chmod +x "$alltests_configure"
