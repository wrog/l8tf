AUTOM4TE = autom4te
M4SH = $(AUTOM4TE) --language=m4sh
AUTOTEST = $(AUTOM4TE) --language=autotest
ALL_TESTSUITES = main_suite unit_suite

all: configure $(ALL_TESTSUITES)

configure: $(l8_abs_root)/alltests_config.ac
	cat paths.m4 | ( cd $(l8_abs_root); cat - alltests_config.ac | autoconf - ) >$@
	chmod +x $@

%:$(l8_abs_root)/%.at
	cat paths.m4 | ( cd $(l8_abs_root); $(AUTOTEST) - $< ) >"$@"
	chmod +x $@

runall: $(l8_abs_root)/runall.m4
	cat paths.m4 | ( cd $(l8_abs_root); $(M4SH) - runall.m4 ) >$@

config.status: configure
	./config.status --recheck

t0/Makefile.in t0/atlocal.in: config.lastrun

config.lastrun: config.status $(l8_abs_root)/t0/Makefile.in $(l8_abs_root)/t0/atlocal.in
	@echo "[ $? ]"
	./config.status

clean: clean-keeps-testsuites clean-keeps-configure

clean-keeps-testsuites:
	rm -f $(ALL_TESTSUITES)

clean-keeps-configure:
	rm -f configure

distclean: clean
	rm -rf t0/Makefile.in t0/atlocal.in config.log config.status config.cache config.lastrun
