
AUTOM4TE = autom4te
AUTOTEST = $(AUTOM4TE) --language=autotest
ALL_TESTSUITES = testbuild

TESTSUITE = testbuild

$(TESTSUITE): $(TESTSUITE).at local.at package.m4 version_l8tf.m4
	$(AUTOTEST) -I m4 -o $@.tmp $@.at
	mv $@.tmp $@

configure: configure.ac aclocal.m4 m4/*.m4
	@echo "[ $? ]"
	autoconf

config.status: configure
	./config.status --recheck

aclocal.m4: configure.ac
	aclocal

Makefile t0/atlocal: config.lastrun

config.lastrun: config.status Makefile.in t0/atlocal.in
	@echo "[ $? ]"
	./config.status

clean: clean-keeps-testsuites

clean-keeps-testsuites:
	rm -rf $(ALL_TESTSUITES)

distclean: clean
	rm -rf Makefile t0/atlocal config.log config.status config.cache config.lastrun

gitclean: distclean
	rm -rf configure aclocal.m4 autom4te.cache
