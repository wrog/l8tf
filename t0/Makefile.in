# test run directory makefile

@l8tf_subj_makevars@

top_alltestdir = $(top_srcdir)/@l8tf_alltestdir@
abs_top_alltestdir = $(abs_top_srcdir)/@l8tf_alltestdir@

l8tf_rootdir = $(top_alltestdir)/@l8tf_rootdir@
abs_l8tf_rootdir = $(abs_top_alltestdir)/@l8tf_rootdir@

top_TS = $(top_alltestdir)/$(TESTSUITE)

check test: atconfig atlocal $(top_TS)
	@MAKE=$(MAKE) $(SHELL) '$(top_TS)' $(TESTSUITEFLAGS)

clean:
	test ! -f '$(top_TS)' || $(SHELL) '$(top_TS)' --clean

atlocal: $(top_alltestdir)/t0/atlocal.in
	cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@
