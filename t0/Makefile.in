# @ALL_XT_CSRCS@

subdir = t
top_srcdir = @top_srcdir@
abs_top_srcdir = @abs_top_srcdir@
top_builddir = @top_builddir@
abs_top_builddir = @abs_top_builddir@
top_testsrcdir = $(top_builddir)/@l8tf_top_testsrcdir@
abs_top_testsrcdir = $(abs_top_builddir)/@l8tf_top_testsrcdir@

TESTSUITE = testbuild
top_TS = $(top_testsrcdir)/$(TESTSUITE)

check test: atconfig atlocal $(top_TS)
	@$(SHELL) '$(top_TS)' $(TESTSUITEFLAGS)

clean:
	test ! -f '$(top_TS)' || $(SHELL) '$(top_TS)' --clean

atconfig: $(abs_top_builddir)/config.status
	cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@

atlocal: $(top_testsrcdir)/config.lastrun
	cp $(top_testsrcdir)/t0/atlocal $@

$(top_TS): $(top_testsrcdir)/config.lastrun
	@$(MAKE) -C $(top_testsrcdir) $(TESTSUITE)

$(top_testsrcdir)/config.lastrun:
	cd $(top_testsrcdir) && { test -r configure || autoreconf; } && ./configure
